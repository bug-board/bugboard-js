{
  "name": "bugboard",
  "version": "1.2.0",
  "description": "Official BugBoard SDK for JavaScript and TypeScript — report bugs as cards on your project board from Node, the browser, or the edge.",
  "keywords": [
    "bugboard",
    "bug-tracking",
    "bug-reporting",
    "bug-monitoring",
    "bug-tracker",
    "error-tracking",
    "error-reporting",
    "error-monitoring",
    "crash-reporting",
    "exception-tracking",
    "exception-handling",
    "issue-tracking",
    "observability",
    "monitoring",
    "logging",
    "analytics",
    "typescript",
    "nodejs",
    "browser",
    "edge"
  ],
  "homepage": "https://github.com/bug-board/bugboard-js#readme",
  "bugs": {
    "url": "https://github.com/bug-board/bugboard-js/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bug-board/bugboard-js.git"
  },
  "license": "MIT",
  "author": "BugBoard (https://bugboard.dev)",
  "type": "module",
  "sideEffects": [
    "./dist/preload.js",
    "./dist/preload.cjs"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./preload": {
      "types": "./dist/preload.d.ts",
      "import": "./dist/preload.js",
      "require": "./dist/preload.cjs"
    },
    "./vite": {
      "types": "./dist/plugin/vite.d.ts",
      "import": "./dist/plugin/vite.js",
      "require": "./dist/plugin/vite.cjs"
    },
    "./rollup": {
      "types": "./dist/plugin/vite.d.ts",
      "import": "./dist/plugin/vite.js",
      "require": "./dist/plugin/vite.cjs"
    },
    "./webpack": {
      "types": "./dist/plugin/webpack.d.ts",
      "import": "./dist/plugin/webpack.js",
      "require": "./dist/plugin/webpack.cjs"
    },
    "./esbuild": {
      "types": "./dist/plugin/esbuild.d.ts",
      "import": "./dist/plugin/esbuild.js",
      "require": "./dist/plugin/esbuild.cjs"
    },
    "./package.json": "./package.json"
  },
  "browser": {
    "node:crypto": false
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "SOURCE_LOCATIONS.md"
  ],
  "scripts": {
    "build": "tsup",
    "prepack": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "tweetnacl-sealedbox-js": "^1.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "esbuild": "^0.28.1",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.5",
    "tsup": "^8.5.1",
    "tweetnacl": "^1.0.3",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.63.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20"
  }
}
